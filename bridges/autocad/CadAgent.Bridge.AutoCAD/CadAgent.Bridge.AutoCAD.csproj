<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework><UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable><ImplicitUsings>enable</ImplicitUsings><PlatformTarget>x64</PlatformTarget>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AutoCadDir Condition="'$(AutoCadDir)'==''">C:\Program Files\Autodesk\AutoCAD 2026</AutoCadDir>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../CadAgent.Bridge.Protocol/CadAgent.Bridge.Protocol.csproj" />
    <ProjectReference Include="../CadAgent.Bridge.Transport/CadAgent.Bridge.Transport.csproj" />
    <Reference Include="AcMgd"><HintPath>$(AutoCadDir)\AcMgd.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="AcDbMgd"><HintPath>$(AutoCadDir)\AcDbMgd.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="AcCoreMgd"><HintPath>$(AutoCadDir)\AcCoreMgd.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>
  <Target Name="CheckAutoCadReferences" BeforeTargets="ResolveReferences">
    <Error Condition="!Exists('$(AutoCadDir)\acad.exe')" Text="AutoCAD executable not found: $(AutoCadDir)" />
    <Error Condition="!Exists('$(AutoCadDir)\AcMgd.dll') or !Exists('$(AutoCadDir)\AcDbMgd.dll') or !Exists('$(AutoCadDir)\AcCoreMgd.dll')" Text="AutoCAD managed references missing." />
  </Target>
</Project>
